NET "refclk"        Loc="IO_SB_A8";

NET "led[0]"        Loc="IO_SB_A0"; # LED0
NET "led[1]"        Loc="IO_SB_B0"; # LED1
NET "led[2]"        Loc="IO_SB_A1"; # LED2
NET "led[3]"        Loc="IO_SB_B1"; # LED3
NET "resetn"        Loc="IO_SB_B3"; # LED6
NET "r"             Loc="IO_SB_A3"; # LED7

NET "usb_ufp_dp"    Loc="IO_EA_A0" | slew=fast | pullup=true;
NET "usb_ufp_dm"    Loc="IO_EA_B0" | slew=fast;
